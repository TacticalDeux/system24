  "type": {
    "body": {
      "font": "fonts/DMMono-Regular.ttf",
      "size": 16,
      "weight": 400
    },
    "names": {
      "font": "fonts/DMMono-Medium.ttf",
      "size": 15,
      "weight": 500,
      "letter_spacing": -0.2
    },
    "code": {
      "font": "fonts/DMMono-Regular.ttf",
      "size": 15,
      "weight": 400
    },
    "headings": {
      "font": "fonts/DMMono-Medium.ttf",
      "header_size": 15,
      "title_size": 15,
      "weight": 500
    },
    "labels": {
      "font": "fonts/DMMono-Medium.ttf",
      "size": 14,
      "weight": 500,
      "letter_spacing": 0.2
    },
    "small": {
