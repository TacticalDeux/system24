      "headers": {
        "font": "labels",
        "size": 12,
        "case": "upper",
        "text": "{name}",
        "height": 34,
        "colour": "#aeaeae"
      }
    },
    "member_rows": {
      "height": 42,
      "gap": 2,
      "font": "names",
      "size": 15,
      "inset": [8, 8],
      "reserve": 6,
      "avatar": {
        "size": 32
      },
      "status": "dot",
      "meta": {
        "idle": "away",
        "listening": "listening · {detail|name}",
        "playing": "playing · {name}",
        "max_width": 120
