  "options": [
    {
      "id": "flavour",
      "label": "Flavour",
      "kind": "choice",
      "default": "system24",
      "description": "The palette system24 ships with, or one of its flavours.",
      "choices": [
        {
          "value": "system24",
          "label": "System24"
        },
        {
          "value": "nord",
          "label": "Nord",
          "set": "flavour-nord"
        },
        {
          "value": "tokyo-night",
          "label": "Tokyo",
          "set": "flavour-tokyo-night"
        },
        {
          "value": "catppuccin-mocha",
          "label": "Mocha",
          "set": "flavour-catppuccin-mocha"
        },
        {
          "value": "catppuccin-macchiato",
          "label": "Macchiato",
          "set": "flavour-catppuccin-macchiato"
        },
        {
          "value": "everforest",
          "label": "Everforest",
          "set": "flavour-everforest"
        },
        {
          "value": "rose-pine",
          "label": "Rosé",
          "set": "flavour-rose-pine"
        },
        {
          "value": "rose-pine-moon",
          "label": "Rosé Moon",
          "set": "flavour-rose-pine-moon"
        }
      ]
    },
    {
      "id": "screen-art",
      "label": "Screen art",
      "kind": "choice",
      "default": "grain",
      "description": "Subtle CRT texture, or the original loader art over the window.",
      "choices": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "scanlines",
          "label": "Scanlines",
          "set": "scanlines"
        },
        {
          "value": "grain",
          "label": "Grain",
          "set": "grain"
        },
        {
          "value": "crt",
          "label": "CRT (both)",
          "set": "crt"
        },
        {
          "value": "system24-loader",
          "label": "system24 loader",
          "set": "loader-system24"
        },
        {
          "value": "cats-loader",
          "label": "Cats loader",
          "set": "loader-cats"
        }
      ]
    },
    {
      "id": "panel-labels",
      "label": "Panel labels",
      "kind": "toggle",
      "default": true,
      "description": "Titles over the rail, member list and input, as system24's panel labels.",
      "off": {
        "chrome.labels.rail_title": null,
        "chrome.labels.members_title": null,
        "chrome.labels.composer": null
      }
    },
    {
      "id": "square-corners",
      "label": "Square corners",
      "kind": "toggle",
      "default": true,
      "description": "system24's unrounding. Off restores ordinary rounded corners.",
      "off": "rounded"
    },
    {
      "id": "small-user-panel",
      "label": "Compact user panel",
      "kind": "toggle",
      "default": false,
      "description": "Hides your avatar for a shorter account panel; the closest match to system24's setting.",
      "on": {
        "chrome.hide": ["account-avatar"]
      }
    },
    {
      "id": "remove-pfp-decor",
      "label": "Remove avatar decorations",
      "kind": "toggle",
      "default": true,
      "description": "Keeps profile pictures plain, as system24's square, undecorated avatars.",
      "off": {
        "content.avatars.decorations": "keep"
      }
    },
    {
      "id": "animations",
      "label": "Animations",
      "kind": "toggle",
      "default": true,
      "description": "The blinking input cursor and the channel-change fade.",
      "off": {
        "animations": [],
        "art.transition": null
      }
    }
  ]
}
