  "spacing": {
    "avatar_size": 32,
    "channel_row_height": 32,
    "chat_padding": 20,
    "density": "default",
    "member_row_height": 42,
    "members_width": 240,
    "message_gap": 4,
    "message_group_gap": 16,
    "sidebar_width": 240
  },
  "motion": {
    "close": "reverse",
    "curve": "ease-out",
    "hover": "fade",
    "hover_in": 200,
    "hover_out": 200,
    "open": "fade",
    "popup": 120,
    "press": "none",
    "quick": 200,
    "unfocused": "slow"
  },
  "animations": [
    {
      "name": "typing dots blink",
      "slot": "typing",
      "property": "opacity",
      "values": [1, 0.35],
      "period": 1060,
      "steps": 2
    },
    {
      "name": "channel name slides in",
      "slot": "channel.name",
      "property": "x",
      "values": [-8, 0],
      "period": 200,
      "repeat": "once"
    },
    {
      "name": "unread pill breathes",
      "slot": "unread",
      "property": "opacity",
      "values": [1, 0.55, 1],
      "period": 2400,
      "steps": 24
    },
    {
      "name": "mention badge heartbeat",
      "slot": "mention",
      "property": "scale",
      "values": [1, 1.3, 1],
      "period": 700,
      "repeat": "once"
    },
    {
      "name": "profile name slides in",
      "slot": "profile.name",
      "property": "x",
      "values": [-8, 0],
      "period": 200,
      "repeat": "once"
    }
  ],
  "effects": {},
